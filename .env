# WebTerm Configuration
PORT=13399
ENABLE_HTTPS=true
SSL_CERT_PATH=certs/cert.pem
SSL_KEY_PATH=certs/key.pem
# Password is stored strictly as SHA-256 hash. Plaintext is never persisted.
TERMINAL_PASSWORD_HASH=ef797c8118f02dfb649607dd5d3f8c7623048c9c063d532cc95c5ed7a898a64f
DEFAULT_SHELL=/bin/bash
MAX_HISTORY_LINES=2000
# Set to 0 to keep terminal sessions persistent indefinitely (tmux-like behavior, never killed on disconnect)
SESSION_TIMEOUT_MINUTES=0
